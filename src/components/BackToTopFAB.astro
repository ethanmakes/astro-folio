---
// 替代原 React 版 BackToTopFAB：滚动 >100 显示（缩放淡入），点击平滑回顶。
---

<div class="fixed right-4 bottom-6 z-10">
  <button
    id="back-to-top"
    class="size-10 rounded-full shadow-lg shadow-zinc-800/5 border border-primary bg-white/50 dark:bg-zinc-800/50 backdrop-blur opacity-0 scale-0 pointer-events-none transition-all duration-300"
    type="button"
    aria-label="Back to top"
  >
    <i class="iconfont icon-rocket"></i>
  </button>
</div>

<script>
  import { getScrollState, onScrollStateChange, startScrollTracking } from '@/scripts/scroll'

  function apply() {
    const btn = document.getElementById('back-to-top')
    if (!btn) return
    const show = getScrollState().y > 100
    btn.classList.toggle('opacity-0', !show)
    btn.classList.toggle('scale-0', !show)
    btn.classList.toggle('pointer-events-none', !show)
  }

  function init() {
    startScrollTracking()
    apply()
    const btn = document.getElementById('back-to-top')
    if (btn && btn.dataset.bound !== 'true') {
      btn.dataset.bound = 'true'
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })
    }
  }

  const w = window as any
  if (!w.__backToTopBound) {
    w.__backToTopBound = true
    onScrollStateChange(apply)
  }

  document.addEventListener('astro:page-load', init)
  init()
</script>
