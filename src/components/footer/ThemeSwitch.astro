---
// 替代原 React 版 ThemeSwitch：三档主题切换（light/system/dark）。
// 行为不变：滑块位移 4/36/68px；localStorage key 沿用 gyoza-theme；
// system 档跟随系统主题变化（原 ThemeProvider 逻辑合并到此处脚本）。
---

<div class="relative inline-block" id="theme-switch">
  <div
    id="theme-switch-thumb"
    class="absolute -z-1 top-1 size-[32px] rounded-full bg-primary transition-transform shadow"
    style="transform: translateX(36px)"
  >
  </div>
  <div class="p-[3px] flex rounded-full border border-primary" role="radiogroup">
    <button
      class="size-[32px] flex items-center justify-center"
      type="button"
      aria-label="Switch to light theme"
      data-theme-value="light"
    >
      <i class="iconfont icon-sun"></i>
    </button>
    <button
      class="size-[32px] flex items-center justify-center"
      type="button"
      aria-label="Switch to system theme"
      data-theme-value="system"
    >
      <i class="iconfont icon-computer"></i>
    </button>
    <button
      class="size-[32px] flex items-center justify-center"
      type="button"
      aria-label="Switch to dark theme"
      data-theme-value="dark"
    >
      <i class="iconfont icon-moon"></i>
    </button>
  </div>
</div>

<script>
  import { changePageTheme, getLocalTheme, getSystemTheme, setLocalTheme } from '@/utils/theme'

  const POSITIONS: Record<string, number> = { light: 4, system: 36, dark: 68 }

  function applyTheme(theme: string) {
    setLocalTheme(theme)
    if (theme === 'system') {
      changePageTheme(getSystemTheme())
    } else {
      changePageTheme(theme)
    }
    const thumb = document.getElementById('theme-switch-thumb')
    if (thumb) {
      thumb.style.transform = `translateX(${POSITIONS[theme] ?? 36}px)`
    }
  }

  function initThemeSwitch() {
    const root = document.getElementById('theme-switch')
    if (!root || root.dataset.bound === 'true') return
    root.dataset.bound = 'true'

    applyTheme(getLocalTheme())

    root.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = btn.dataset.themeValue
        if (value) applyTheme(value)
      })
    })
  }

  const w = window as any
  if (!w.__themeMediaBound) {
    w.__themeMediaBound = true
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
      if (getLocalTheme() === 'system') {
        changePageTheme(event.matches ? 'dark' : 'light')
      }
    })
  }

  document.addEventListener('astro:page-load', initThemeSwitch)
  initThemeSwitch()
</script>
