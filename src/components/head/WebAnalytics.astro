---
// 替代原 WebAnalytics.tsx：行为不变（DEV 或 analytics.enable=false 时不输出任何脚本）
import { analytics } from '@/config.json'

const show = !import.meta.env.DEV && analytics.enable
const umami = analytics.umami
const google = analytics.google
const clarity = analytics.microsoftClarity
---

{
  show && umami.websiteId && (
    <script defer src={`${umami.serverUrl || 'https://cloud.umami.is'}/script.js`} data-website-id={umami.websiteId} />
  )
}
{
  show && google.measurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${google.measurementId}`} />
      <script is:inline set:html={`window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\ngtag('js', new Date());\n\ngtag('config', '${google.measurementId}');`} />
    </>
  )
}
{
  show && clarity.projectId && (
    <script
      is:inline
      set:html={`(function(c,l,a,r,i,t,y){\n            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};\n            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;\n            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);\n          })(window, document, "clarity", "script", "${clarity.projectId}");`}
    />
  )
}
