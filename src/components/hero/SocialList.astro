---
// 刊头内的社交链接：安静的图标行，无色块背景，hover 时着 accent 色。
import clsx from 'clsx'
import { hero } from '@/config.json'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<ul class={clsx('flex flex-wrap items-center gap-5', className)}>
  {
    hero.socials.map((social) => (
      <li>
        <a
          class="block text-[22px] leading-none text-secondary transition-colors hover:text-accent"
          href={social.url}
          title={social.name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class={clsx('iconfont', social.icon)} />
          <span class="sr-only">{social.name}</span>
        </a>
      </li>
    ))
  }
</ul>
