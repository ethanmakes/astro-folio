---
// 替代原 React 版 Header 全家（Header/HeaderContent/HeaderMeta/AnimatedLogo/
// BluredBackground/HeaderDrawer/hooks）：服务端渲染 + 原生脚本驱动滚动状态。
// 行为与原版一致：
// - 顶栏毛玻璃背景 opacity 随滚动 60→120 线性加深（保留两位小数）；lg 起改用常驻通栏背景层
// - 桌面菜单：md 保留背景辉光胶囊（顶部 60px 内显示，滚动后背景消失）；
//   lg 改为通栏顶栏：品牌字标居左、菜单横排（当前页 accent 色 + 加粗 + 底部实色下划线）
// - 主题切换从页脚移入顶栏右侧（lg 显示）与移动端抽屉顶部，全站只此一处逻辑
// - 文章页顶栏二态（方向感知 + 累计 8px 迟滞防抖）：顶部与上滑时为品牌+菜单常态，
//   下滑越过 60px 后与文章 meta 互换；旧版上滑浮动胶囊菜单已删除，全站只剩这一套导航逻辑
// - 移动端：抽屉菜单（条目 stagger）、meta 出现时 logo 淡出
import { menus, author, site } from '@/config.json'
import SearchPanel from './SearchPanel.astro'
import ThemeSwitch from './ThemeSwitch.astro'
import { withBase } from '@/utils/url'

interface Props {
  title?: string
  description?: string
}

const { title = '', description = '' } = Astro.props

const hasMeta = title !== '' && description !== ''
// Astro.url.pathname 含部署 base（如 /astro-folio/archives），而 config 的 menu.link
// 是根相对语义（/archives）：比较前先剥掉 base 前缀，否则子路径下当前页高亮永远失效。
const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '')
const rawPath = Astro.url.pathname
const strippedPath =
  basePrefix && (rawPath === basePrefix || rawPath.startsWith(`${basePrefix}/`))
    ? rawPath.slice(basePrefix.length) || '/'
    : rawPath
const pathName = strippedPath === '/' ? '/' : strippedPath.replace(/\/$/, '')

const menuItems = menus.map((menu) => ({ ...menu, isActive: pathName === menu.link }))

const menuBgClasses =
  'bg-gradient-to-b from-zinc-50/70 to-white/90 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-md dark:from-zinc-900/70 dark:to-zinc-800/90 dark:ring-zinc-100/10'
---

<header class="fixed top-0 inset-x-0 h-[64px] lg:h-[80px] z-10 overflow-hidden" data-has-meta={hasMeta}>
  <div
    id="header-bg"
    class="lg:hidden absolute inset-0 -z-1 border-b border-primary bg-white/70 dark:bg-zinc-800/70 backdrop-saturate-150 backdrop-blur-lg transform-gpu"
    style="opacity: 0"
  >
  </div>
  {/* lg 通栏顶栏的常驻背景：半透明 + 毛玻璃 + 底部 hairline 分隔线 */}
  <div
    class="hidden lg:block absolute inset-0 -z-1 border-b border-primary bg-white/70 dark:bg-zinc-800/70 backdrop-saturate-150 backdrop-blur-lg"
    aria-hidden="true"
  >
  </div>
  <div
    class="max-w-[1100px] h-full md:px-4 lg:px-8 mx-auto grid grid-cols-[64px_auto_64px] lg:grid-cols-[auto_1fr_auto]"
  >
    <div class="flex items-center justify-center lg:justify-start">
      <button
        id="drawer-open"
        class="md:hidden size-9 rounded-full shadow-lg shadow-zinc-800/5 border border-primary bg-white/50 dark:bg-zinc-800/50 backdrop-blur"
        type="button"
        aria-label="Open menu"
      >
        <i class="iconfont icon-menu"></i>
      </button>
      <a class="hidden md:block lg:hidden" href={withBase('/')} title="Nav to home">
        <img
          class="size-[40px] select-none object-cover rounded-2xl"
          src={withBase(author.avatar)}
          alt="Site owner avatar"
        />
      </a>
      {/* lg 品牌区：logo + 放大加粗的站点字标 */}
      <a class="hidden lg:flex items-center gap-3 shrink-0" href={withBase('/')} title="Nav to home">
        <img
          class="size-[44px] select-none object-cover rounded-2xl"
          src={withBase(author.avatar)}
          alt="Site owner avatar"
        />
        <span class="text-[21px] font-bold leading-none tracking-tight">{site.title}</span>
      </a>
    </div>
    <div class="relative flex items-center justify-center">
      <a
        id="logo-mobile"
        class="md:hidden block transition-opacity duration-300"
        href={withBase('/')}
        title="Nav to home"
      >
        <img
          class="size-[40px] select-none object-cover rounded-2xl"
          src={withBase(author.avatar)}
          alt="Site owner avatar"
        />
      </a>
      <div id="header-menu-wrap" class="hidden md:block lg:h-full transition-opacity duration-300">
        <nav
          id="header-menu"
          class:list={['lg:hidden relative rounded-full group pointer-events-auto duration-200', menuBgClasses]}
        >
          <div
            class="header-menu-glow absolute -z-1 -inset-px rounded-full opacity-0 group-hover:opacity-100 duration-500"
            aria-hidden="true"
          >
          </div>
          <div class="text-sm px-4 flex">
            {
              menuItems.map((menu) => (
                <a
                  class:list={[
                    'relative block px-4 py-1.5',
                    menu.isActive ? 'text-accent' : 'hover:text-accent',
                  ]}
                  href={withBase(menu.link)}
                >
                  <div class="flex space-x-2">
                    {menu.isActive && <i class:list={['iconfont menu-icon-in', menu.icon]} />}
                    <span>{menu.name}</span>
                  </div>
                  {menu.isActive && (
                    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-accent/70 to-transparent" />
                  )}
                </a>
              ))
            }
          </div>
        </nav>
        {/* lg 横排菜单：与品牌同行，当前页 accent 色 + 加粗 + 顶栏底部实色下划线 */}
        <nav id="header-menu-lg" class="hidden lg:block h-full" aria-label="Main navigation">
          <div class="flex h-full gap-10">
            {
              menuItems.map((menu) => (
                <a
                  class:list={[
                    'relative flex items-center gap-2 px-1 text-[15px]',
                    menu.isActive ? 'text-accent font-semibold' : 'hover:text-accent',
                  ]}
                  href={withBase(menu.link)}
                >
                  {menu.isActive && <i class:list={['iconfont menu-icon-in', menu.icon]} />}
                  <span>{menu.name}</span>
                  {menu.isActive && <span class="absolute inset-x-0 bottom-0 h-[2px] bg-accent" />}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
      {
        hasMeta && (
          <div
            id="header-meta"
            class="absolute inset-0 z-1 flex items-center justify-between md:px-10 opacity-0 translate-y-5 pointer-events-none transition-all duration-300"
          >
            <div class="grow min-w-0">
              <div class="text-secondary text-xs truncate">{description}</div>
              <h2 class="truncate text-lg">{title}</h2>
            </div>
          </div>
        )
      }
    </div>
    <div class="flex items-center justify-center lg:justify-end lg:gap-3">
      <div class="hidden lg:block">
        <ThemeSwitch />
      </div>
      <button
        id="search-open"
        class="size-9 lg:size-11 lg:text-lg rounded-full shadow-lg shadow-zinc-800/5 border border-primary bg-white/50 dark:bg-zinc-800/50 backdrop-blur"
        type="button"
        aria-label="Search"
      >
        <i class="iconfont icon-search"></i>
      </button>
    </div>
  </div>
</header>

{/* 移动端抽屉（原 radix Dialog + framer-motion，改原生 + CSS 过渡） */}
<div
  id="drawer-overlay"
  class="md:hidden fixed inset-0 bg-gray-800/40 opacity-0 pointer-events-none transition-opacity duration-300"
  style="z-index: 998"
>
</div>
<div
  id="drawer-panel"
  class="md:hidden fixed left-0 inset-y-0 h-full bg-primary rounded-r-lg p-4 flex flex-col justify-center w-[260px] max-w-[80%] -translate-x-full transition-transform duration-200 ease-out"
  style="z-index: 999"
  role="dialog"
  aria-modal="true"
>
  <div class="flex items-center justify-between px-2">
    <span class="text-sm text-secondary">主题</span>
    <ThemeSwitch />
  </div>
  <ul class="mt-8 pb-8 overflow-y-auto overflow-x-hidden min-h-0">
    {
      menuItems.map((menu, i) => (
        <li
          class="drawer-item opacity-0 -translate-x-full transition-all duration-200 ease-out"
          style={`transition-delay: ${0.1 + i * 0.1}s`}
        >
          <a class="drawer-link inline-flex p-2 space-x-4" href={withBase(menu.link)}>
            <i class:list={['iconfont', menu.icon]} />
            <span>{menu.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<SearchPanel />

<script>
  import { getScrollState, onScrollStateChange, startScrollTracking } from '@/scripts/scroll'

  const MENU_BG_CLASSES = [
    'bg-gradient-to-b',
    'from-zinc-50/70',
    'to-white/90',
    'shadow-lg',
    'shadow-zinc-800/5',
    'ring-1',
    'ring-zinc-900/5',
    'backdrop-blur-md',
    'dark:from-zinc-900/70',
    'dark:to-zinc-800/90',
    'dark:ring-zinc-100/10',
  ]

  // 顶栏二态的迟滞状态挂在 window 上：滚动回调只注册一次且 VT 软导航后脚本会
  // 重新执行，状态必须跨闭包、跨页面一致，不能用某个闭包内的局部变量。
  interface HeaderMetaState {
    meta: boolean
    minY: number
    maxY: number
  }

  function getHeaderMetaState(): HeaderMetaState {
    const w = window as any
    if (!w.__headerMetaState) w.__headerMetaState = { meta: false, minY: 0, maxY: 0 }
    return w.__headerMetaState as HeaderMetaState
  }

  function resetHeaderMetaState(y: number) {
    const s = getHeaderMetaState()
    s.meta = false
    s.minY = y
    s.maxY = y
  }

  function applyScrollState() {
    const { y } = getScrollState()
    const header = document.querySelector<HTMLElement>('header[data-has-meta]')
    if (!header) return
    const hasMeta = header.dataset.hasMeta === 'true'

    // 毛玻璃背景 opacity：60 以下 0，120 以上 1，中间线性（保留两位小数）
    const bg = document.getElementById('header-bg')
    if (bg) {
      let opacity: number
      if (y >= 120) opacity = 1
      else if (y <= 60) opacity = 0
      else opacity = Math.floor(((y - 60) / 60) * 100) / 100
      bg.style.opacity = String(opacity)
    }

    // 桌面菜单背景：滚动 <60 显示
    const menu = document.getElementById('header-menu')
    if (menu) {
      MENU_BG_CLASSES.forEach((c) => menu.classList.toggle(c, y < 60))
    }

    // 文章页顶栏二态（方向感知 + 累计 8px 迟滞防抖）：
    // 顶部（y<60）恒为常态；常态下自最低点累计下滚 ≥8px 且越过 60 → meta 态；
    // meta 态下自最高点累计上滚 ≥8px → 恢复常态。临界点附近的小幅抖动不触发切换。
    const hs = getHeaderMetaState()
    if (!hasMeta || y < 60) {
      hs.meta = false
      hs.minY = y
      hs.maxY = y
    } else if (!hs.meta) {
      hs.minY = Math.min(hs.minY, y)
      if (y - hs.minY >= 8) {
        hs.meta = true
        hs.maxY = y
      }
    } else {
      hs.maxY = Math.max(hs.maxY, y)
      if (hs.maxY - y >= 8) {
        hs.meta = false
        hs.minY = y
      }
    }
    const showMeta = hasMeta && hs.meta

    const meta = document.getElementById('header-meta')
    if (meta) {
      meta.classList.toggle('opacity-0', !showMeta)
      meta.classList.toggle('translate-y-5', !showMeta)
      meta.classList.toggle('pointer-events-none', !showMeta)
    }

    const menuWrap = document.getElementById('header-menu-wrap')
    if (menuWrap) {
      menuWrap.classList.toggle('opacity-0', showMeta)
      menuWrap.classList.toggle('pointer-events-none', showMeta)
    }

    const logoMobile = document.getElementById('logo-mobile')
    if (logoMobile) {
      logoMobile.classList.toggle('opacity-0', showMeta)
      logoMobile.classList.toggle('pointer-events-none', showMeta)
    }

  }

  function closeDrawer() {
    const overlay = document.getElementById('drawer-overlay')
    const panel = document.getElementById('drawer-panel')
    if (!overlay || !panel) return
    overlay.classList.add('opacity-0', 'pointer-events-none')
    panel.classList.add('-translate-x-full')
    panel.querySelectorAll('.drawer-item').forEach((item) => {
      item.classList.add('opacity-0', '-translate-x-full')
    })
  }

  function openDrawer() {
    const overlay = document.getElementById('drawer-overlay')
    const panel = document.getElementById('drawer-panel')
    if (!overlay || !panel) return
    overlay.classList.remove('opacity-0', 'pointer-events-none')
    panel.classList.remove('-translate-x-full')
    panel.querySelectorAll('.drawer-item').forEach((item) => {
      item.classList.remove('opacity-0', '-translate-x-full')
    })
  }

  function initHeader() {
    startScrollTracking()
    // 新页面（含 VT 软导航）从常态起步，迟滞极值以当前滚动位置为锚
    resetHeaderMetaState(getScrollState().y)
    applyScrollState()

    // 菜单径向辉光
    document.querySelectorAll<HTMLElement>('.header-menu').forEach((nav) => {
      if (nav.dataset.glowBound === 'true') return
      nav.dataset.glowBound = 'true'
      const glow = nav.querySelector<HTMLElement>('.header-menu-glow')
      if (!glow) return
      nav.addEventListener('mousemove', (e) => {
        const bounds = nav.getBoundingClientRect()
        const x = e.clientX - bounds.left
        const y = e.clientY - bounds.top
        const radius = Math.sqrt(bounds.width ** 2 + bounds.height ** 2) / 2.5
        glow.style.background = `radial-gradient(${radius}px circle at ${x}px ${y}px, rgb(var(--color-accent) / 0.12) 0%, transparent 65%)`
      })
    })

    const openBtn = document.getElementById('drawer-open')
    if (openBtn && openBtn.dataset.bound !== 'true') {
      openBtn.dataset.bound = 'true'
      openBtn.addEventListener('click', openDrawer)
    }
    const overlay = document.getElementById('drawer-overlay')
    if (overlay && overlay.dataset.bound !== 'true') {
      overlay.dataset.bound = 'true'
      overlay.addEventListener('click', closeDrawer)
    }
    document.querySelectorAll('.drawer-link').forEach((a) => {
      a.addEventListener('click', closeDrawer)
    })

    const searchBtn = document.getElementById('search-open')
    if (searchBtn && searchBtn.dataset.bound !== 'true') {
      searchBtn.dataset.bound = 'true'
      searchBtn.addEventListener('click', () => (window as any).__openSearch?.())
    }
  }

  const w = window as any
  if (!w.__headerScrollBound) {
    w.__headerScrollBound = true
    onScrollStateChange(applyScrollState)
  }

  document.addEventListener('astro:page-load', initHeader)
  initHeader()
</script>
