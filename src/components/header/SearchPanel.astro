---
// 替代原 React 版 SearchButton + SearchPanel：原生 <dialog> + pagefind。
// 行为与原版一致：Ctrl/Cmd+K 或点击搜索按钮打开，输入 350ms 防抖搜索，结果结构不变。
---

<dialog
  id="search-dialog"
  class="bg-transparent border-none p-0 outline-none max-w-none max-h-none"
  data-dev={import.meta.env.DEV}
>
  <div
    id="search-panel"
    class="bg-primary rounded-lg w-[90vw] h-[80vh] max-w-[680px] max-h-[480px] border border-primary flex flex-col"
  >
    <input
      id="search-input"
      class="px-4 py-3 outline-none bg-transparent border-b border-primary"
      type="text"
      placeholder="Search..."
      maxlength="64"
    />
    <div id="search-results" class="px-4 py-3 overflow-y-auto grow"></div>
    <div class="px-3 py-2 flex justify-end">
      <a
        href="https://pagefind.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center"
      >
        <span class="mr-2 text-xs">Search by</span>
        <span class="font-semibold">pagefind</span>
      </a>
    </div>
  </div>
</dialog>

<style>
  #search-dialog::backdrop {
    background: rgb(31 41 55 / 0.4);
  }
  #search-dialog[open] #search-panel {
    animation: search-panel-in 0.25s ease-out;
  }
  @keyframes search-panel-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const ICON_SEARCH = `<svg xmlns="http://www.w3.org/2000/svg" width="2em" viewBox="0 0 24 24"><path fill="currentColor" d="m18.031 16.617l4.283 4.282l-1.415 1.415l-4.282-4.283A8.96 8.96 0 0 1 11 20c-4.968 0-9-4.032-9-9s4.032-9 9-9s9 4.032 9 9a8.96 8.96 0 0 1-1.969 5.617m-2.006-.742A6.98 6.98 0 0 0 18 11c0-3.867-3.133-7-7-7s-7 3.133-7 7s3.133 7 7 7a6.98 6.98 0 0 0 4.875-1.975z"/></svg>`
  const ICON_LOADING = `<svg xmlns="http://www.w3.org/2000/svg" width="2em" viewBox="0 0 24 24" class="animate-spin"><path fill="currentColor" d="M12 2a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1m0 15a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1m8.66-10a1 1 0 0 1-.366 1.366l-2.598 1.5a1 1 0 1 1-1-1.732l2.598-1.5A1 1 0 0 1 20.66 7M7.67 14.5a1 1 0 0 1-.367 1.366l-2.598 1.5a1 1 0 1 1-1-1.732l2.598-1.5a1 1 0 0 1 1.366.366M20.66 17a1 1 0 0 1-1.366.366l-2.598-1.5a1 1 0 0 1 1-1.732l2.598 1.5A1 1 0 0 1 20.66 17M7.67 9.5a1 1 0 0 1-1.367.366l-2.598-1.5a1 1 0 1 1 1-1.732l2.598 1.5A1 1 0 0 1 7.67 9.5"/></svg>`
  const ICON_DEV = `<svg xmlns="http://www.w3.org/2000/svg" width="2em" viewBox="0 0 24 24"><path fill="currentColor" d="M4 20v-6a8 8 0 1 1 16 0v6h1v2H3v-2zm2 0h12v-6a6 6 0 0 0-12 0zm5-18h2v3h-2zm8.778 2.808l1.414 1.414l-2.12 2.121l-1.415-1.414zM2.808 6.222l1.414-1.414l2.121 2.12L4.93 8.344zM7 14a5 5 0 0 1 5-5v2a3 3 0 0 0-3 3z"/></svg>`
  const ICON_EMPTY = `<svg xmlns="http://www.w3.org/2000/svg" width="2em" viewBox="0 0 24 24"><path fill="currentColor" d="M11 11v2l-5.327 6H11v2H3v-2l5.326-6H3v-2zm10-8v2l-5.327 6H21v2h-8v-2l5.326-6H13V3z"/></svg>`

  // pagefind 索引生成在站点根（部署时即 base 子路径下），脚本与结果地址都要带 base 前缀。
  // 注意：本版本 import.meta.env.BASE_URL 为 '/astro-folio'（无尾斜杠），拼接前先归一化。
  const BASE_PREFIX = import.meta.env.BASE_URL.replace(/\/$/, '')
  function withBasePrefix(url: string) {
    if (!url.startsWith('/') || !BASE_PREFIX) return url
    if (url === BASE_PREFIX || url.startsWith(`${BASE_PREFIX}/`)) return url
    return `${BASE_PREFIX}${url}`
  }

  let pagefind: any = null
  async function loadPagefind() {
    if (!pagefind) {
      const url = `${BASE_PREFIX}/pagefind/pagefind.js`
      pagefind = await import(/* @vite-ignore */ url)
    }
  }

  function centerWrap(inner: string) {
    return `<div class="h-full flex items-center justify-center">${inner}</div>`
  }

  function initSearch() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
    if (!dialog || dialog.dataset.bound === 'true') return
    dialog.dataset.bound = 'true'

    const input = document.getElementById('search-input') as HTMLInputElement
    const resultsBox = document.getElementById('search-results') as HTMLDivElement
    const dlg = dialog
    const isDev = dialog.dataset.dev === 'true'

    let keyword = ''
    let results: any[] = []
    let isLoading = false

    function render() {
      if (isDev) {
        resultsBox.innerHTML = centerWrap(
          `<div class="flex gap-2">${ICON_DEV}<div><div class="font-semibold mb-1">抱歉</div><div class="text-sm">该功能基于 pagefind，请在构建后再次尝试。</div></div></div>`,
        )
        return
      }
      if (isLoading) {
        resultsBox.innerHTML = centerWrap(ICON_LOADING)
        return
      }
      if (keyword.length === 0) {
        resultsBox.innerHTML = centerWrap(ICON_SEARCH)
        return
      }
      if (results.length === 0) {
        resultsBox.innerHTML = centerWrap(
          `<div class="flex flex-col items-center gap-2">${ICON_EMPTY}<div>无内容</div></div>`,
        )
        return
      }
      const items = results
        .map(
          (item) => `<a href="${withBasePrefix(item.url)}" class="hover:bg-accent/10 rounded block px-3 py-2" data-search-result>
            <div class="font-semibold">${item.meta.title}</div>
            <p class="text-sm">${item.excerpt}</p>
          </a>`,
        )
        .join('')
      resultsBox.innerHTML = `<div class="text-sm px-3 mb-2">找到以下 ${results.length} 条结果</div>${items}`
      resultsBox.querySelectorAll('[data-search-result]').forEach((a) => {
        a.addEventListener('click', () => dlg.close())
      })
    }

    async function search(value: string) {
      if (!value) {
        results = []
        render()
        return
      }
      isLoading = true
      render()
      await loadPagefind()
      if (pagefind) {
        const res = await pagefind.search(value)
        results = await Promise.all(res.results.map((r: any) => r.data()))
      }
      isLoading = false
      render()
    }

    let debounceTimer: number | undefined
    input.addEventListener('input', () => {
      keyword = input.value
      window.clearTimeout(debounceTimer)
      debounceTimer = window.setTimeout(() => search(keyword), 350)
    })

    // 点击背景关闭（dialog 本体即背景层，面板为其子元素）
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    })

    render()
  }

  function openSearch() {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
    if (!dialog) return
    initSearch()
    if (!dialog.open) dialog.showModal()
    const input = document.getElementById('search-input') as HTMLInputElement | null
    input?.focus()
  }

  ;(window as any).__openSearch = openSearch

  const w = window as any
  if (!w.__searchHotkeyBound) {
    w.__searchHotkeyBound = true
    window.addEventListener('keydown', (event) => {
      if (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) {
        event.preventDefault()
        openSearch()
      }
    })
  }

  document.addEventListener('astro:page-load', initSearch)
  initSearch()
</script>
