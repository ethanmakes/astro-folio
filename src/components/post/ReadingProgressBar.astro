---
// 文章阅读进度线：2px 强调色线，贴顶栏下边缘，宽度 = 正文阅读进度。
// 仅由 MarkdownLayout 引入（文章页 / spec 页），非文章页不渲染。
// 进度口径由 src/scripts/reading-progress.ts 统一提供，与侧栏百分比同源。
---

<div id="reading-progress-track" aria-hidden="true">
  <div id="reading-progress-fill"></div>
</div>

<style is:global>
  #reading-progress-track {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 30;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    #reading-progress-track {
      top: 80px;
    }
  }

  #reading-progress-fill {
    height: 100%;
    width: 0;
    background-color: rgb(var(--color-accent) / 1);
  }
</style>

<script>
  import { getReadingProgress } from '@/scripts/reading-progress'

  let rafId = 0

  function paint() {
    rafId = 0
    const fill = document.getElementById('reading-progress-fill')
    if (!fill) return

    fill.style.width = `${(getReadingProgress() * 100).toFixed(2)}%`
  }

  function requestPaint() {
    if (rafId) return
    rafId = requestAnimationFrame(paint)
  }

  function initProgressBar() {
    requestPaint()
  }

  const w = window
  if (!w.__readingProgressBarBound) {
    w.__readingProgressBarBound = true
    window.addEventListener('scroll', requestPaint, { passive: true })
    window.addEventListener('resize', requestPaint)
  }

  document.addEventListener('astro:page-load', initProgressBar)
  initProgressBar()
</script>
