---
import type { CollectionEntry } from 'astro:content'
import { withBase } from '@/utils/url'

interface Props {
  name: string
  posts: CollectionEntry<'posts'>[]
  currentId: string
}

const { name, posts, currentId } = Astro.props
---

<nav class="rounded-lg border border-primary px-5 py-4" aria-label={`系列：${name}`}>
  <div class="flex items-baseline gap-2">
    <span class="text-xs tracking-widest text-secondary">系列</span>
    <span class="font-semibold">{name}</span>
    <span class="text-xs text-secondary">共 {posts.length} 篇</span>
  </div>
  <ol class="mt-3 space-y-1.5">
    {
      posts.map((post, i) => {
        const isCurrent = post.id === currentId
        return (
          <li class="flex items-baseline gap-2.5 text-[15px]">
            <span class:list={['text-xs tabular-nums', isCurrent ? 'text-accent' : 'text-secondary']}>
              {String(i + 1).padStart(2, '0')}
            </span>
            {isCurrent ? (
              <span class="text-accent font-semibold" aria-current="page">
                {post.data.title}
                <span class="ml-1.5 text-xs font-normal text-secondary">（本篇）</span>
              </span>
            ) : (
              <a class="hover:text-accent" href={withBase(`/posts/${post.id}`)}>
                {post.data.title}
              </a>
            )}
          </li>
        )
      })
    }
  </ol>
</nav>
