---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'
import PostCardHoverOverlay from './PostCardHoverOverlay.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<div class="relative" data-post-list>
  <PostCardHoverOverlay />
  <ul class="-my-4">
    {
      posts.map((post) => (
        <li>
          <PostCard entry={post} />
        </li>
      ))
    }
  </ul>
</div>
