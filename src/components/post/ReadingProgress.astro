---
// 替代原 React 版 ReadingProgress：百分比与顶栏进度线共用
// src/scripts/reading-progress.ts 的统一口径，此处只负责取整显示。
---

<div>
  <span class="text-sm">进度 <span id="reading-progress">0</span>%</span>
</div>

<script>
  import { onScrollStateChange, startScrollTracking } from '@/scripts/scroll'
  import { getReadingProgress } from '@/scripts/reading-progress'

  function updateProgress() {
    const el = document.getElementById('reading-progress')
    if (!el) return
    if (!document.querySelector('#markdown-wrapper')) return

    el.textContent = String(Math.floor(getReadingProgress() * 100))
  }

  function initProgress() {
    startScrollTracking()
    updateProgress()
  }

  const w = window
  if (!w.__readingProgressBound) {
    w.__readingProgressBound = true
    onScrollStateChange(updateProgress)
  }

  document.addEventListener('astro:page-load', initProgress)
  initProgress()
</script>
