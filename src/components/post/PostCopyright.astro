---
// 替代原 React 版 PostCopyright：最后修改时间改服务端格式化直出（原版客户端 useEffect 计算，结果一致）；
// 复制链接走自写 toast（原 react-toastify 平替）。
import { author, site } from '@/config.json'
import { getFormattedDateTime } from '@/utils/date'

interface Props {
  title: string
  slug: string
  lastMod: Date
}

const { title, slug, lastMod } = Astro.props

const url = new URL(slug, site.url).href
const lastModStr = getFormattedDateTime(lastMod)
---

<section class="text-xs leading-loose text-secondary">
  <p>文章标题：{title}</p>
  <p>文章作者：{author.name}</p>
  <p>
    <span>文章链接：{url}</span>
    <span role="button" class="cursor-pointer select-none" data-copy-url={url}>[复制]</span>
  </p>
  <p>最后修改时间：{lastModStr}</p>
  <hr class="my-3 border-primary" />
  <div>
    <p>
      商业转载请联系站长获得授权，非商业转载请注明本文出处及文章链接，您可以自由地在任何媒体以任何形式复制和分发作品，也可以修改和创作，但是分发衍生作品时必须采用相同的许可协议。
      <br />
      本文采用
      <a
        class="hover:underline hover:text-accent underline-offset-2"
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh"
        target="_blank"
        rel="noopener noreferrer"
      >
        CC BY-NC-SA 4.0
      </a>
      进行许可。
    </p>
  </div>
</section>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLElement>('[data-copy-url]').forEach((el) => {
      if (el.dataset.bound === 'true') return
      el.dataset.bound = 'true'
      el.addEventListener('click', () => {
        navigator.clipboard.writeText(el.dataset.copyUrl!)
        ;(window as any).toast?.success('已复制文章链接')
      })
    })
  }

  document.addEventListener('astro:page-load', initCopyButtons)
  initCopyButtons()
</script>
