---
// 代码块复制按钮：由 MarkdownLayout 引入，脚本为正文每个 .code-block 注入一个
// 右上角复制按钮。桌面（hover + fine pointer）默认隐藏，hover / focus-within
// 时淡入；触屏常显。点击走 navigator.clipboard，成功后就地显示「已复制」。
---

<style is:global>
  .markdown .code-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    line-height: 1.25rem;
    border-radius: 0.375rem;
    border: 1px solid rgb(var(--color-accent) / 0.35);
    background-color: rgb(var(--color-accent) / 0.14);
    color: inherit;
    cursor: pointer;
    opacity: 0.85;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .markdown .code-copy-btn:hover {
    background-color: rgb(var(--color-accent) / 0.28);
  }

  .markdown .code-copy-btn.is-copied {
    background-color: rgb(var(--color-accent) / 1);
    border-color: transparent;
    color: #fff;
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .markdown .code-copy-btn {
      opacity: 0;
    }

    .markdown .code-block:hover .code-copy-btn,
    .markdown .code-block:focus-within .code-copy-btn,
    .markdown .code-copy-btn.is-copied {
      opacity: 1;
    }
  }
</style>

<script>
  const REVERT_MS = 1600

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch {
      // clipboard API 不可用（非安全上下文等）时退回 execCommand
      const ta = document.createElement('textarea')
      ta.value = text
      ta.style.position = 'fixed'
      ta.style.opacity = '0'
      document.body.appendChild(ta)
      ta.select()
      let ok = false
      try {
        ok = document.execCommand('copy')
      } catch {
        ok = false
      }
      ta.remove()
      return ok
    }
  }

  function initCodeCopy() {
    const blocks = document.querySelectorAll<HTMLElement>('#markdown-wrapper .code-block')
    blocks.forEach((block) => {
      if (block.querySelector(':scope > .code-copy-btn')) return
      const code = block.querySelector('pre code')
      if (!code) return

      const btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'code-copy-btn'
      btn.textContent = '复制'
      btn.setAttribute('aria-label', '复制代码')

      let timer: number | undefined
      btn.addEventListener('click', async () => {
        const ok = await copyText(code.textContent ?? '')
        if (!ok) return
        btn.textContent = '已复制'
        btn.classList.add('is-copied')
        window.clearTimeout(timer)
        timer = window.setTimeout(() => {
          btn.textContent = '复制'
          btn.classList.remove('is-copied')
        }, REVERT_MS)
      })

      block.appendChild(btn)
    })
  }

  document.addEventListener('astro:page-load', initCodeCopy)
  initCodeCopy()
</script>
