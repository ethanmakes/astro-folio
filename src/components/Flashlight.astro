---
// 替代原 React 版 Flashlight（404 页手电筒）：径向渐变跟随鼠标，仅 hover 设备启用。
---

<div id="flashlight" class="fixed inset-0 z-50 pointer-events-none" style="display: none"></div>

<script>
  function initFlashlight() {
    const el = document.getElementById('flashlight')
    if (!el || el.dataset.bound === 'true') return
    if (window.matchMedia('(hover: hover)').matches) {
      el.dataset.bound = 'true'
      el.style.display = 'block'
      document.addEventListener('mousemove', (event) => {
        el.style.backgroundImage = `radial-gradient(
          circle 16vmax at ${event.clientX}px ${event.clientY}px,
          rgba(0, 0, 0, 0) 0%,
          rgba(0, 0, 0, 0.5) 80%,
          rgba(0, 0, 0, 0.8) 100%
        )`
      })
    }
  }

  document.addEventListener('astro:page-load', initFlashlight)
  initFlashlight()
</script>
