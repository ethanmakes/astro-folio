---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import BackToTopFAB from '@/components/BackToTopFAB.astro'
import { ClientRouter } from 'astro:transitions'
import { site } from '@/config.json'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
}

const { title, description, image } = Astro.props
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <CommonHead title={title} description={description} image={image} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
    <ClientRouter />
  </head>
  <body>
    <slot />

    <BackToTopFAB />
    <script>
      import { toast } from '@/scripts/toast'
      ;(window as any).toast = toast
    </script>
  </body>
</html>
