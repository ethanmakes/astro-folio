---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import MarkdownLayout from '@/layouts/MarkdownLayout.astro'
import { getSortedPosts } from '@/utils/content'
import MarkdownWrapper from '@/components/MarkdownWrapper.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import PostToc from '@/components/post/PostToc.astro'
import PostMetaInfo from '@/components/post/PostMetaInfo.astro'
import PostArchiveInfo from '@/components/post/PostArchiveInfo.astro'
import ReadingProgress from '@/components/post/ReadingProgress.astro'
import Outdate from '@/components/post/Outdate.astro'
import PostNav from '@/components/post/PostNav.astro'
import PostSeries from '@/components/post/PostSeries.astro'
import { Comments } from '@/components/comment'
import ActionAside from '@/components/post/ActionAside.astro'
import PostCopyright from '@/components/post/PostCopyright.astro'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()

  // 同系列文章列表：优先 seriesOrder 升序，未填的按日期排在已填之后；
  // 系列不足 2 篇时返回空数组（不渲染系列框）。必须定义在 getStaticPaths
  // 内部——Astro 预渲染时外部辅助函数不可用。
  function getSeriesPosts(
    all: CollectionEntry<'posts'>[],
    current: CollectionEntry<'posts'>,
  ): CollectionEntry<'posts'>[] {
    const series = current.data.series
    if (!series) return []
    const siblings = all.filter((p) => p.data.series === series)
    if (siblings.length < 2) return []
    return siblings.sort((a, b) => {
      const ao = a.data.seriesOrder
      const bo = b.data.seriesOrder
      if (ao != null && bo != null) return ao - bo || a.data.date.valueOf() - b.data.date.valueOf()
      if (ao != null) return -1
      if (bo != null) return 1
      return a.data.date.valueOf() - b.data.date.valueOf()
    })
  }

  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      current: post,
      prev: index > 0 ? sortedPosts[index - 1] : undefined,
      next: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined,
      seriesPosts: getSeriesPosts(sortedPosts, post),
    },
  }))
}) satisfies GetStaticPaths

interface Props {
  current: CollectionEntry<'posts'>
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  seriesPosts: CollectionEntry<'posts'>[]
}

const { current, prev, next, seriesPosts } = Astro.props

const { headings, Content, remarkPluginFrontmatter } = await render(current)

const mdSlug = `/posts/${current.id}`

const mdDescription = concat(current.data.category || '', current.data.tags.join(', '))

function concat(str1: string, str2: string, sep = ' / ') {
  if (str1 && str2) return str1 + sep + str2
  if (str1) return str1
  if (str2) return str2
  return ''
}

const lastMod = current.data.lastMod || current.data.date
---

<MarkdownLayout
  title={current.data.title}
  description={current.data.summary}
  image={current.data.cover}
  mdTitle={current.data.title}
  mdDescription={mdDescription}
>
  <div
    class="max-w-[1100px] mx-auto px-4 md:px-8 py-16 grid lg:grid-cols-[auto_260px] gap-8"
    data-pagefind-body
  >
    <div>
      <header class="space-y-4">
        <h1 class="text-4xl font-bold text-center">
          {current.data.title}
        </h1>
        <PostMetaInfo
          class="justify-center"
          date={current.data.date}
          lastMod={current.data.lastMod}
          words={remarkPluginFrontmatter.words}
          readingMinutes={remarkPluginFrontmatter.readingMinutes}
        />
        <PostArchiveInfo
          class="justify-center"
          category={current.data.category}
          tags={current.data.tags}
        />
        <div>
          <Outdate lastMod={lastMod} />
        </div>
      </header>
    </div>
    <div class="col-start-1 min-w-0">
      <MarkdownWrapper>
        <Content />
      </MarkdownWrapper>
    </div>
    <div class="hidden lg:block" data-pagefind-ignore>
      <aside class="sticky top-20">
        <SectionBlock title="目录">
          <PostToc headings={headings} />
          <hr class="my-2 border-primary max-w-[100px]" />
          <ReadingProgress />
        </SectionBlock>
        <ActionAside title={current.data.title} slug={mdSlug} />
      </aside>
    </div>
    <div data-pagefind-ignore>
      <section class="space-y-6">
        <PostCopyright title={current.data.title} slug={mdSlug} lastMod={lastMod} />
        {
          seriesPosts.length >= 2 && (
            <PostSeries name={current.data.series!} posts={seriesPosts} currentId={current.id} />
          )
        }
        <PostNav prev={prev} next={next} />
        {current.data.comments && <Comments />}
      </section>
    </div>
  </div>
</MarkdownLayout>
